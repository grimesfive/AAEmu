<Project>
  <PropertyGroup>
    <Company>AAEmu</Company>
    <Copyright>Copyright (c) 2019 - 2024 the AAEmu contributors</Copyright>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64;linux-x64;linux-arm64;linux-arm;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <!-- Base version should be updated automically; build number automically increases -->
    <AAEmuBaseVersion>0.3.0</AAEmuBaseVersion>
    <AAEmuBuildNumber>0</AAEmuBuildNumber>
    <AAEmuVersion>$(AAEmuBaseVersion).$(AAEmuBuildNumber)</AAEmuVersion>

    <Version>$(AAEmuVersion)</Version>
    <VersionPrefix>$(AAEmuVersion)</VersionPrefix>
    <AssemblyVersion>$(AAEmuVersion)</AssemblyVersion>
    <FileVersion>$(AAEmuVersion)</FileVersion>
    <InformationalVersion>$(AAEmuVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <VersionSuffix>alpha</VersionSuffix>

    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
